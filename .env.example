# Backend settings. Copy to server/.env (the API reads .env from its working
# directory). Every value has a sensible default for local development.

# REQUIRED in production: a long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

DATABASE_URL=sqlite:///./ajaia_docs.db

# Origins allowed to call the API cross-origin. Only matters if the frontend is
# served from a different origin; the Vite dev proxy and production are same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Frontend (optional): put in client/.env to call an API on another origin.
# Leave unset to use the same-origin /api path.
# VITE_API_URL=http://localhost:8000/api
